{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "parent_review",
        "student_achievement",
        "score_improvement",
        "competition_result",
        "student_project"
      ],
      "enumColors": [
        "blue",
        "green",
        "yellow",
        "purple",
        "pink"
      ],
      "default": "parent_review"
    },
    "quote": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "description": "Display name \u2014 use initials or 'Parent of a Grade 9 student' unless permission has been given"
    },
    "detail": {
      "type": "string",
      "description": "e.g. Grade 10 student"
    },
    "highlight": {
      "type": "string",
      "description": "Short result, e.g. SAT 1280 \u2192 1480"
    },
    "programSlug": {
      "type": "string",
      "description": "Program page slug this story belongs to"
    },
    "permissionGranted": {
      "type": "boolean",
      "default": false,
      "description": "Parent permission received to show real name/photo"
    },
    "sortOrder": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "quote",
    "author"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}