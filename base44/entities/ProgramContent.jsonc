{
  "name": "ProgramContent",
  "type": "object",
  "properties": {
    "slug": { "type": "string" },
    "contentJson": { "type": "string", "description": "Editable program page content in JSON format" }
  },
  "required": ["slug", "contentJson"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
