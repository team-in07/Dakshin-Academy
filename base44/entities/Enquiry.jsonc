{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "parentName": {
      "type": "string",
      "description": "Parent's name"
    },
    "studentName": {
      "type": "string",
      "description": "Student's name"
    },
    "grade": {
      "type": "string",
      "description": "Student grade"
    },
    "program": {
      "type": "string",
      "description": "Program or subject needed"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "preferredTiming": {
      "type": "string",
      "description": "Preferred class timing"
    },
    "message": {
      "type": "string",
      "description": "Message from the parent"
    },
    "source": {
      "type": "string",
      "description": "Page where the enquiry was submitted"
    },
    "followUpStatus": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "assessment_booked",
        "enrolled",
        "closed"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "purple",
        "green",
        "gray"
      ],
      "default": "new",
      "description": "Follow-up status"
    },
    "adminNotes": {
      "type": "string",
      "description": "Internal notes"
    }
  },
  "required": [
    "parentName",
    "studentName",
    "phone",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}